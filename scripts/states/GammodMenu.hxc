		/*Tweens.cancel('recolor_bg');
		//bg.color = 0x00000000;
		Tweens.color(
			'recolor_bg',
			bg,
			0xFFFFFFFF,
			0.7,
			0.2,
			'quartOut'
		);*/

		introProgressChange = FlxTween.num
		(
			0,
			1,
			0.7,
			{
				ease: FlxEase.quartOut,
			},
			(value) ->
			{
				introProgress = value;
			}
		);

		new FlxTimer().start
		(
			0.3 + appear_delay,
			()->
			{
				can_write_desc = true;
				writeDescription();
			}
		);

		new FlxTimer().start
		(
			0.6, 
			()->
			{
				if (!transitioningOut)
				{
					if (!rendering_animation) renderAnimation();
					FlxG.state.subState.persistentDraw = false;

					// BACKDROPS
					Tweens.cancel('appear_upBackdrop');
					Tweens.tween(
						'appear_upBackdrop',
						upperBackdropTxt,
						{ y: 50 },
						0.4,
						0.3,
						'expoOut'
					);
					Tweens.cancel('decelerate_upBackdrop');
					Tweens.tween(
						'decelerate_upBackdrop',
						upperBackdropTxt.velocity,
						{ x: 20 },
						2,
						0.5,
						'expoOut'
					);
					Tweens.cancel('appear_downBackdrop');
					Tweens.tween(
						'appear_downBackdrop',
						bottomBackdropTxt,
						{ y: 580 },
						0.4,
						0.3,
						'expoOut'
					);
					Tweens.cancel('decelerate_downBackdrop');
					Tweens.tween(
						'decelerate_downBackdrop',
						bottomBackdropTxt.velocity,
						{ x: -20 },
						2,
						0.5,
						'expoOut'
					);

					transitionTint.alpha = 0;

					bg.alpha = 1;
					bg.color = 0xFFFFFFFF;
					Tweens.cancel('flash_bg');
					Tweens.color(
						'flash_bg',
						bg,
						0xFF6400D8,
						1,
						0,
						'expoOut'
					);
					Tweens.cancel('appear_upperBarBG');
					Tweens.tween(
						'appear_upperBarBG',
						upperBarBG,
						{ y: -100 },
						0.5,
						0.05,
						'expoOut'
					);
					Tweens.cancel('appear_bottomBarBG');
					Tweens.tween(
						'appear_bottomBarBG',
						bottomBarBG,
						{ y: 600 },
						0.5,
						0,
						'expoOut'
					);
					/*Tweens.cancel('slide_mods');
					Tweens.tween(
						'slide_mods',
						visible_mods_text,
						{ x: 0, y: 0 },
						0.7,
						0,
						'expoOut'
					);
					Tweens.cancel('slide_play');
					Tweens.tween(
						'slide_play',
						visible_play_text,
						{ x: 0, y: 0 },
						0.7,
						0,
						'expoOut'
					);
					new FlxTimer().start
					(
						0.7,
						()->
						{
							animTextSlide();
						}
					);*/
				}
			}
		);

		new FlxTimer().start
		(
			0.6 + appear_delay,
			()->
			{
				if (transitioningOut) return; 
				transitioningIn = false;
			}
		);

		new FlxTimer().start
		(
			0.8 + appear_delay,
			()->
			{
				if (transitioningOut) return;
				if (needs_unranked && ModuleHandler.getModule('GammodMult').unranked)
				{
					showUnranked();
				}
			}
		);
	}

	public function showUnranked()
	{
		if (showing_unranked_sign) return;
		var da_y:Int = 540;
		needs_unranked = false;
		showing_unranked_sign = true;
		scoreWontSave.shader.brightness = 100;
		scoreWontSave.shader.contrast = -10;
		scoreWontSave.visible = true;
		scoreWontSave.y = da_y + 20;
		Tweens.cancel('appear_unranked');
		Tweens.tween
		(
			'appear_unranked',
			scoreWontSave,
			{ y: da_y + 34 },
			0.2,
			0,
			'quadOut',
			'oneshot',
			()->
			{
				if (!transitioningIn) FunkinSound.playOnce(Paths.sound('optionUnranked'));
				scoreWontSave.shader.brightness = 0;
				scoreWontSave.shader.contrast = 0;
				Tweens.tween
				(
					'appear_unranked',
					scoreWontSave,
					{ y: da_y },
					0.2,
					0,
					'expoIn'
				);
			}
		);
		var animSpeedSecs: Float = 0.7; // animSpeedWHAAT???
		if (unrkPulseTimer != null)
		{
			unrkPulseTimer.cancel();
			unrkPulseTimer.destroy();
			unrkPulseTimer = null;
		}
		scoreWontSave.alpha = 1;
		unrk_pulse_out = true;
		unrkPulseTimer = FlxTimer.loop
		(
			animSpeedSecs,
			()->
			{
				if (unrk_pulse_out)
				{
					Tweens.cancel('pulseOut_unranked');
					Tweens.cancel('pulseIn_unranked');
					Tweens.tween
					(
						'pulseOut_unranked',
						scoreWontSave,
						{ alpha: 0.5 },
						animSpeedSecs,
						'easeInOut'
					);
				}
				else
				{
					Tweens.cancel('pulseOut_unranked');
					Tweens.cancel('pulseIn_unranked');
					Tweens.tween
					(
						'pulseIn_unranked',
						scoreWontSave,
						{ alpha: 1 },
						animSpeedSecs,
						'easeInOut'
					);
				}
				unrk_pulse_out = !unrk_pulse_out;
			},
			0
		);
	}

	public function hideUnranked()
	{
		Tweens.cancel('pulseOut_unranked');
		Tweens.cancel('pulseIn_unranked');
		scoreWontSave.visible = false;
		showing_unranked_sign = false;
		if (unrkPulseTimer != null)
		{
			unrkPulseTimer.cancel();
			unrkPulseTimer.destroy();
			unrkPulseTimer = null;
		}
	}

	public override function destroy():Void
	{
		super.destroy();

		if (lightsTimer != null) lightsTimer.destroy();
		if (slideLapTimer != null) slideLapTimer.destroy();
	}

	public function arrangeButtonsVertically()
	{
		for (button in 0...buttons.length)
		{
			buttons[button].y = (buttons[button].height + button_spacing) * button;
		}
	}

	public function writeDescription(?description: String)
	{
		if (description == null) description = buttons[selected_button].assigned_mod.description;
		writing_animation = true;
		desc_content = description;
		funTxt.text = '';

		desc_progress = 1;
		if (textWriteTimer != null)
		{
			textWriteTimer.cancel();
			textWriteTimer.destroy();
			textWriteTimer = null;
		}
		textWriteTimer = FlxTimer.loop
		(
			0.025,
			()->
			{
				desc_progress += 1;
				funTxt.text = desc_content.substr(0,desc_progress);
				var sound:FunkinSound = FunkinSound.playOnce(Paths.sound('textWrite/' + FlxG.random.int(1,6)));
				sound.pitch = FlxG.random.float(0.8,1.2);
				sound.volume = 10;
			},
			description.length
		);
	}

	public function selectButton(?button: Int, from_freeplay: Bool = false)
	{
		if (button == selected_button) return;
		if (selected_button != null)
		{
			Tweens.cancel('select_currentButton' + buttons[selected_button].ID);
			Tweens.tween(
				'deselect_previousButton' + buttons[selected_button].ID,
				buttons[selected_button],
				{ x: deselected_position + buttonGroup.x },
				0.3,
				0,
				'circOut'
			);
			buttons[selected_button].pullDownOverlay();
		}

		if (button != null) selected_button = button;

		handleOptions(from_freeplay);

		selectedArrow.x = -200;
		arrow_hover = false;
		Tweens.cancel('move_selectedArrow');
		Tweens.tween(
			'move_selectedArrow',
			selectedArrow,
			{ x: -2 },
			0.2,
			0,
			'circOut',
			'oneshot',
			function ()
			{
				arrow_hover = true;
			}
		);

		Tweens.cancel('deselect_previousButton' + buttons[selected_button].ID);
		Tweens.tween(
			'select_currentButton' + buttons[selected_button].ID,
			buttons[selected_button],
			{ x: selected_offset + buttonGroup.x },
			0.3,
			0,
			'circOut'
		);
		buttons[selected_button].pullUpOverlay();

		Tweens.cancel('move_buttonGroup');
		Tweens.tween(
			'move_buttonGroup',
			buttonGroup,
			{ y: ((FlxG.height / 2) - ((buttons[0].height + button_spacing) * selected_button) - (buttons[0].height)) + 9 },
			0.5,
			0,
			'quadOut'
		);
		if (!from_freeplay)
		{
			FunkinSound.playOnce(Paths.sound('buttonSelect'));

			if (extraSpeedChange != null)
			{
				extraSpeedChange.cancel();
				extraSpeedChange.destroy();
				extraSpeedChange = null;
			}

			//bg.shader.setColors(buttons[selected_button].assigned_mod.colors[0], buttons[selected_button].assigned_mod.colors[1]);

			extraSpeedChange = FlxTween.num
			(
				1,
				extraSpeedPeak,
				0.1,
				{
					ease: FlxEase.circOut,
					onComplete:
					() ->
					{
						extraSpeedChange = FlxTween.num
						(
							extraSpeedPeak,
							1,
							0.4,
							{
								ease: FlxEase.expoInOut,
							},
							(value) ->
							{
								extraSpeed = value;
							}
						);
					}
				},
				(value) ->
				{
					extraSpeed = value;
				}
			);
		}
	}

	public function handleOptions(from_freeplay: Bool = false) // TO CHANGE TO A NEW MOD
	{
		refreshCurrentOption(from_freeplay);

		if (can_write_desc) writeDescription((from_freeplay ? '' : null));

		if (!from_freeplay) renderAnimation();
	}

	public function juiceMult()
	{
		if (shaderTimer != null)
		{
			shaderTimer.cancel();
			shaderTimer.destroy();
			shaderTimer = null;
		}
		multiplierNum.shader.set_shakeRate(1);
		multiplierNum.shader.set_shakePower(0.1);
		shaderTimer = new FlxTimer().start
		(
			0.12,
			()->
			{
				multiplierNum.shader.set_shakePower(0);
				multiplierNum.shader.set_shakeRate(0);
			}
		);
	}

	public function renderAnimation()
	{
		rendering_animation = true;
		optionTxt.clipRect = new FlxRect(0, 0, optionTxt.width, 0);
		if (textAnimator != null) textAnimator.cancel();
		textAnimator = FlxTween.num
		(
			0,
			optionTxt.height,
			0.5,
			{
				onComplete: () ->
				{
					optionTxt.clipRect = null;
					rendering_animation = false;
				}
			},
			(value) ->
			{
				optionTxt.clipRect = new FlxRect(0, 0, optionTxt.width, value);
			}
		);
		borderColor.color = 0xFF888888;
		optionTxt.color = 0xFFFFFFFF;
		Tweens.cancel('recolor_optionTxt');
		Tweens.cancel('recolor_optionTxt2');
		Tweens.cancel('recolor_optionTxt3');
		Tweens.color(
			'recolor_optionTxt',
			borderColor,
			0xFFFFFFFF,
			0.3,
			0,
			'quadIn'
		);
		Tweens.color(
			'recolor_optionTxt2',
			borderColor,
			0xFF000000,
			0.3,
			0.3,
			'linear'
		);
		Tweens.color(
			'recolor_optionTxt3',
			optionTxt,
			intended_option_color,
			0.2,
			0.1,
			'linear'
		);
		renderSound_step = FlxMath.wrap(renderSound_step + 1, 1, 4);
		if (renderSound != null) renderSound.destroy();
		renderSound = FunkinSound.playOnce(Paths.sound('renderSounds/' + renderSound_step), 4);
	}

	public function wrapFloat(value: Float, min: Float, max: Float):Float
	{
		if (value > max) return min;
		if (value < min) return max;
		return value;
	}

	public function wrapInt(value: Int, min: Int, max: Int):Int
	{
		if (value > max) return min;
		if (value < min) return max;
		return value;
	}

	public function switchCurrentOption(right: Bool, to_limit: Bool = false) // TO SWITCH AROUND THE OPTION OF THE CURRENTLY SELECTED MOD
	{
		var at_pre_default:Bool = false;
		trace(buttons[selected_button].assigned_mod);
		if (buttons[selected_button].assigned_mod.pre_default != null) at_pre_default = buttons[selected_button].assigned_mod.value == (buttons[selected_button].assigned_mod.pre_default ?? null);
		
		// Logic that determines how pressing left or right affects the currently selected option.
		if (to_limit)
		{
			switch(buttons[selected_button].assigned_mod.type)
			{
				case GammodModType.SWITCH:
					buttons[selected_button].assigned_mod.value = right;
				case GammodModType.LIST(values):
					buttons[selected_button].assigned_mod.value = right ? values[values.length-1] : buttons[selected_button].assigned_mod.default_value;
				case GammodModType.INTRANGE(min, max, step), GammodModType.FLOATRANGE(min, max, step):
					buttons[selected_button].assigned_mod.value = !right ? min : max;
			}
		}
		else
		{
			switch(buttons[selected_button].assigned_mod.type)
			{
				case GammodModType.SWITCH:
					buttons[selected_button].assigned_mod.value = at_pre_default ? buttons[selected_button].assigned_mod.default_value : !buttons[selected_button].assigned_mod.value;
				case GammodModType.LIST(values):
					buttons[selected_button].assigned_mod.value = at_pre_default ? buttons[selected_button].assigned_mod.default_value : values[FlxMath.wrap(values.indexOf(buttons[selected_button].assigned_mod.value) + (right ? 1 : -1), 0, values.length - 1)];
				case GammodModType.INTRANGE(min, max, step):
					buttons[selected_button].assigned_mod.value = at_pre_default ? buttons[selected_button].assigned_mod.default_value : wrapInt(buttons[selected_button].assigned_mod.value + (right ? step : -step), min, max);
				case GammodModType.FLOATRANGE(min, max, step):
					trace(at_pre_default);
					buttons[selected_button].assigned_mod.value = at_pre_default ? buttons[selected_button].assigned_mod.default_value : FlxMath.roundDecimal(wrapFloat(buttons[selected_button].assigned_mod.value + (right ? step : -step), min, max), FlxMath.getDecimals(step));
			}
		}
		if (GammodMult.getMult(buttons[selected_button].assigned_mod) == null)
		{
			intended_option_color = 0xFFFF0000;
		}
		else
		{
			intended_option_color = 0xFF66ffff;
		}
		saveValue();
		if (right)
		{
			FunkinSound.playOnce(Paths.sound('optionRight'));
			Tweens.cancel('deselect_previousButton' + buttons[selected_button].ID);
			Tweens.tween(
				'select_currentButton' + buttons[selected_button].ID,
				buttons[selected_button],
				{ x: selected_offset + buttonGroup.x },
				0.3,
				0,
				'circOut'
			);
		} else
		{
			FunkinSound.playOnce(Paths.sound('optionLeft'));
		}

		optionTxt.color = 0xFFFFFFFF;
		Tweens.cancel('recolor_optionTxt3');
		Tweens.color(
			'recolor_optionTxt3',
			optionTxt,
			intended_option_color,
			0.2,
			0.1,
			'linear'
		);

		final respectiveArrow: GammodSelectorArrow;
		if (right)
		{
			respectiveArrow = rightSelectorArrow;
		}
		else
		{
			respectiveArrow = leftSelectorArrow;
		}
		respectiveArrow.setColor(0xFFFFFFFF);
		/*Tweens.cancel('recolor_arrowOff' + (right ? 'Right' : 'Left'));
		Tweens.cancel('recolor_arrowOn' + (right ? 'Right' : 'Left'));
		Tweens.color(
			'recolor_arrowOff' + (right ? 'Right' : 'Left'),
			respectiveArrow.offTexture,
			0xFF66FFFF,
			0.2,
			0.1,
			'linear'
		);
		Tweens.color(
			'recolor_arrowOn' + (right ? 'Right' : 'Left'),
			respectiveArrow.onTexture,
			0xFF66FFFF,
			0.2,
			0.1,
			'linear'
		);*/

		refreshCurrentOption();
	}

	public function saveValue(?index:Int)
	{
		if (index == null) index = selected_button;
		if (Save.instance.getModOptions('Gammod').modifiers == null) Save.instance.getModOptions('Gammod').modifiers = new StringMap();
		Save.instance.getModOptions('Gammod').modifiers.set(buttons[index].assigned_mod.moduleId, buttons[index].assigned_mod.value);
	}

	public function refreshCurrentOption(from_freeplay: Bool = false, advice: Bool = false)
	{
		if (glitchOptionTimer != null)
		{
			glitchOptionTimer.cancel();
			glitchOptionTimer.destroy();
			glitchOptionTimer = null;
		}
		glitchOptionTimer = new FlxTimer().start
		(
			0.3,
			()->
			{
				optionTxt.shader.set_shakeRate(0);
			}
		);
		optionTxt.shader.set_shakeRate(10);
		if (GammodMult.getMult(buttons[selected_button].assigned_mod) == null)
		{
			intended_option_color = 0xFFFF0000;
		}
		else
		{
			if (!advice) intended_option_color = 0xFF66ffff;
		}
		for (button in buttons)
		{
			button.updateDefault();
		}
		if (FlxG.sound.music != null)
		{
			if (ModuleHandler.getModule('GammodPlaybackRate') != null) FlxG.sound.music.pitch = ModuleHandler.getModule('GammodPlaybackRate').value;
		}
		if (!advice)
		{
			var prefix: GammodMorpheme = buttons[selected_button].assigned_mod.prefix ?? '';
			var prefix_result: String = '';
			if (prefix != null)
			{
				prefix_result = prefix.shape;
				if (!prefix.at_default && ModuleHandler.getModule('GammodModifierHandler').checkDefault(buttons[selected_button].assigned_mod)) prefix_result = '';
			}

			var suffix: GammodMorpheme = buttons[selected_button].assigned_mod.suffix ?? '';
			var suffix_result: String = '';
			if (suffix != null)
			{
				suffix_result = suffix.shape;
				if (!suffix.at_default && ModuleHandler.getModule('GammodModifierHandler').checkDefault(buttons[selected_button].assigned_mod)) suffix_result = '';
			}
			if (!Std.is(buttons[selected_button].assigned_mod.value, Int) || !Std.is(buttons[selected_button].assigned_mod.value, Float))
			{
				switch (buttons[selected_button].assigned_mod.value)
				{
					case (false):
						optionTxt.text = 'DISABLED';
					case (true):
						optionTxt.text = 'ACTIVE';
					default:
						trace(buttons[selected_button].assigned_mod.value);
						optionTxt.text = (prefix_result ?? '') + Std.string(buttons[selected_button].assigned_mod.value) + (suffix_result ?? '');
				}
			}
			else
			{
				optionTxt.text = (prefix_result ?? '') + buttons[selected_button].assigned_mod.value + (suffix_result ?? '');
			}
		}
		scale_options_multiplier = optionTxt.width > 510 ? 510 / optionTxt.width : 1;
		if (!from_freeplay)
		{
			optionTxt.scale.set(scale_options_multiplier + 0.3, scale_options_multiplier - 0.4);
			Tweens.cancel('juice_optionTxt');
			Tweens.tween(
				'juice_optionTxt',
				optionTxt.scale,
				{ x: scale_options_multiplier, y: scale_options_multiplier },
				0.2,
				0,
				'circOut'
			);
		}
		else
		{
			optionTxt.scale.set(scale_options_multiplier, scale_options_multiplier);
		}
		optionTxt.x = (optionsTxt_center - (optionTxt.width / 2)) + screen_elemets_offset;
		
		ModuleHandler.getModule('GammodMult').calcMult();
		if (ModuleHandler.getModule('GammodMult').score_multiplier != ModuleHandler.getModule('GammodMult').pre_score_multiplier && !unranked_text)
		{
			juiceMult();
			multiplierNum.text = ModuleHandler.getModule('GammodMult').score_multiplier;
			if (Math.floor(ModuleHandler.getModule('GammodMult').score_multiplier) == ModuleHandler.getModule('GammodMult').score_multiplier)
			{
				multiplierNum.text = multiplierNum.text + '.0';
			}
		}
		multiplierNum.x = ((multScreen.x + (multScreen.width / 2) - (multiplierNum.width / 2)) + 77);
		multiplierNumGlow.x = multiplierNum.x;

		if (!advice)
		{
			leftSelectorArrow.setColor(0xFF66FFFF);
			rightSelectorArrow.setColor(0xFF66FFFF);
		}

		if (advice) 
		{
			optionTxt.scale.set(scale_options_multiplier, scale_options_multiplier);
			optionTxt.borderColor = 0xFF000000;
		}
		
		var previous_show_tip:Bool = show_tip;
		if (!buttons[selected_button].currently_default)
		{
			if (lightsTimer == null)
			{
				lightsTimer = FlxTimer.loop
				(
					0.4, 
					()->
					{
						//FunkinSound.playOnce(Paths.sound('lights' + (lightsOn.alpha == 0 ? 'On' : 'Off')));
						lightsOn.alpha = (lightsOn.alpha == 0 ? 1 : 0);
					},
					0
				);
			}
			show_tip = buttons[selected_button].assigned_mod.pre_default != null;
		}
		else
		{
			show_tip = false;
			if (lightsTimer != null) 
			{
				lightsTimer.destroy();
				lightsTimer = null;
			}
			lightsOn.alpha = 0;
		}

		if (from_freeplay) needs_unranked = true;
		else ModuleHandler.getModule('GammodMult').unranked ? showUnranked() : hideUnranked();

		if (show_tip == previous_show_tip) return; // blud can't spend a day without making a "previous_" prefixed variable 🙏
		if (show_tip)
		{
			Tweens.cancel('move_tipTxt');
			Tweens.tween(
				'move_tipTxt',
				tipTxt,
				{ y: optionsScreen.height + 10, alpha: 0.7 },
				0.2,
				0,
				'quintOut'
			);
		}
		else
		{
			Tweens.cancel('move_tipTxt');
			Tweens.tween(
				'move_tipTxt',
				tipTxt,
				{ y: 0, alpha: 0 },
				0.2,
				0,
				'quadOut'
			);
		}
	}

	public override function update(elapsed:Float)
	{
		super.update(elapsed);

		/*if (ModuleHandler.getModule('GammodMult').unranked && !showing_unranked)
		{
			showing_unranked = true;
			unranked_text = false;
			if (unrankedTimer != null)
			{
				unrankedTimer.cancel();
				unrankedTimer.destroy();
				unrankedTimer = null;
			}
			unrankedTimer = FlxTimer.loop
			(
				1,
				()->
				{
					if (!unranked_text)
					{
						unranked_text = true;
						multiplierNum.text = 'UNRANKED';
						multiplierNumGlow.text = 'UNRANKED';
						multiplierNumGlow.color = 0xFFFF0000;
					}
					else
					{
						unranked_text = false;
						multiplierNum.text = ModuleHandler.getModule('GammodMult').score_multiplier;
						multiplierNumGlow.text = ModuleHandler.getModule('GammodMult').score_multiplier;
						multiplierNumGlow.color = 0xFF66ffff;
						if (Math.floor(ModuleHandler.getModule('GammodMult').score_multiplier) == ModuleHandler.getModule('GammodMult').score_multiplier)
						{
							multiplierNum.text = multiplierNum.text + '.0';
						}
					}
					multiplierNum.x = (multScreen.x + (multScreen.width / 2) - (multiplierNum.width / 2)) + 77;
					multiplierNumGlow.x = multiplierNum.x;
					juiceMult();
				},
				0
			);
		}
		else if (!ModuleHandler.getModule('GammodMult').unranked && showing_unranked)
		{
			showing_unranked = false;
			unranked_text = false;
			if (unrankedTimer != null)
			{
				unrankedTimer.cancel();
				unrankedTimer.destroy();
				unrankedTimer = null;
			}
			unranked_text = false;
			multiplierNum.text = ModuleHandler.getModule('GammodMult').score_multiplier;
			multiplierNumGlow.text = ModuleHandler.getModule('GammodMult').score_multiplier;
			multiplierNumGlow.color = 0xFF66ffff;
			if (Math.floor(ModuleHandler.getModule('GammodMult').score_multiplier) == ModuleHandler.getModule('GammodMult').score_multiplier)
			{
				multiplierNum.text = multiplierNum.text + '.0';
			}
			multiplierNum.x = (multScreen.x + (multScreen.width / 2) - (multiplierNum.width / 2)) + 77;
			multiplierNumGlow.x = multiplierNum.x;
		}*/

		multLight.x = multScreen.x + 22;
		multLight.y = multScreen.y - 15;

		if (!showing_multLight && (GammodMult.curMult() != 1.0))
		{
			showing_multLight = true;
			multLight.visible = true;
			multLight.anim.play('shock', true);
			FunkinSound.playOnce(Paths.sound('multSpark'));
		}
		else if (showing_multLight && (GammodMult.curMult() == 1.0))
		{
			showing_multLight = false;
			multLight.anim.play('shock', true, true);
			FunkinSound.playOnce(Paths.sound('multSparkGo'));
		}

		if (textWriteTimer != null && !textWriteTimer.active)
		{
			if (funTxt.text != desc_content) funTxt.text = desc_content;
			writing_animation = false;
		}

		multiplierNum.shader.update(elapsed);

		//bg.shader.update(elapsed, extraSpeed, introProgress);

		optionTxt.borderColor = borderColor.color;

		multiplierNumGlow.text = multiplierNum.text;

		selectedArrow.y = buttons[selected_button].y + 28;

		leftArrowHitbox.x = leftSelectorArrow.members[0].x - hitbox_amplitude;
		leftArrowHitbox.y = leftSelectorArrow.members[0].y - hitbox_amplitude;
		leftArrowHitbox.makeGraphic(leftSelectorArrow.members[0].width+(hitbox_amplitude * 2), leftSelectorArrow.members[0].height+(hitbox_amplitude * 2), FlxColor.TRANSPARENT);

		rightArrowHitbox.x = rightSelectorArrow.members[0].x - hitbox_amplitude;
		rightArrowHitbox.y = rightSelectorArrow.members[0].y - hitbox_amplitude;
		rightArrowHitbox.makeGraphic(rightSelectorArrow.members[0].width+(hitbox_amplitude * 2), rightSelectorArrow.members[0].height+(hitbox_amplitude * 2), FlxColor.TRANSPARENT);

		optionsSliderHitbox.x = leftSelectorArrow.members[0].x + leftSelectorArrow.members[0].width;
		optionsSliderHitbox.y = 0;
		optionsSliderHitbox.makeGraphic(500, 130, FlxColor.TRANSPARENT);

		resetModsHitbox.x = FlxG.width - 130;
		resetModsHitbox.y = 0;
		resetModsHitbox.makeGraphic(130, 130, FlxColor.TRANSPARENT);

		for (button in buttons)
		{
			button.update(elapsed);
		}

		final wheelAmount:Float = FlxG.mouse.wheel / 8;
		if (wheelAmount != 0)
		{
			if (FlxG.keys.pressed.CONTROL)
			{
				switchCurrentOption(wheelAmount > 0 ? true : false);
				return;
			}
			if (allow_input) selectButton(FlxMath.wrap(selected_button + (wheelAmount > 0 ? -1 : 1), 0, buttons.length - 1));
		}

		if (allow_input)
		{
			var isMobile:Bool = Gammod.mobile();

			var leftPress = isMobile ? controls.get_UI_LEFT_P() || (TouchUtil.justPressed && TouchUtil.overlaps(leftArrowHitbox, camera)) : controls.get_UI_LEFT_P();
			var rightPress = isMobile ? controls.get_UI_RIGHT_P() || (TouchUtil.justPressed && TouchUtil.overlaps(rightArrowHitbox, camera)) : controls.get_UI_RIGHT_P();
			var leftRelease = isMobile ? controls.get_UI_LEFT_R() || (TouchUtil.justReleased && TouchUtil.overlaps(leftArrowHitbox, camera)) : controls.get_UI_LEFT_R();
			var rightRelease = isMobile ? controls.get_UI_RIGHT_R() || (TouchUtil.justReleased && TouchUtil.overlaps(rightArrowHitbox, camera)) : controls.get_UI_RIGHT_R();
			var upPress = controls.get_UI_UP_P();
			var downPress = controls.get_UI_DOWN_P();
			var upRelease = controls.get_UI_UP_R();
			var downRelease = controls.get_UI_DOWN_R();

			var leftHold = isMobile ? controls.get_UI_LEFT() || (TouchUtil.pressed && TouchUtil.overlaps(leftArrowHitbox, camera)) : controls.get_UI_LEFT();
			var rightHold = isMobile ? controls.get_UI_RIGHT() || (TouchUtil.pressed && TouchUtil.overlaps(rightArrowHitbox, camera)) : controls.get_UI_RIGHT();
			var doHoldLeft = leftHold && !rightFirst;
			var upHold = controls.get_UI_UP();
			var doHoldUp = upHold && !downFirst;
			var downHold = controls.get_UI_DOWN();
			var controlPress = isMobile ? FlxG.keys.justPressed.CONTROL || (TouchUtil.justPressed && TouchUtil.overlaps(optionsSliderHitbox, camera)) : FlxG.keys.justPressed.CONTROL;
			
			leftSelectorArrow.update(leftHold, elapsed);
			rightSelectorArrow.update(rightHold, elapsed);
			
			if ((FlxG.android != null && (FlxG.android.justReleased.BACK)) || (Gammod.mobile() && (TouchUtil.pressAction() && TouchUtil.overlaps(backButton))))
			{
				goToFreeplay();
				return;
			}
			switch (true)
			{
				case (controlPress):
					if (doubleClickTimer != null) 
					{
						doubleClickTimer.destroy();
						doubleClickTimer = null;
						HapticUtil.vibrate(0.01, 0.02, 0.2);
						screenCam.shake(0.01,0.1);
						var mod = buttons[selected_button];
						mod.removeOn(true);
						
						if (mod.assigned_mod.pre_default != null)
						{
							mod.assigned_mod.value = mod.assigned_mod.pre_default;
						}
						else
						{
							if (mod.assigned_mod.type == GammodModType.SWITCH)
							{
								mod.assigned_mod.value = mod.assigned_mod.default_value;
							}
							else
							{
								mod.assigned_mod.value = mod.assigned_mod.default_value;
							}
						}
						saveValue();
						refreshCurrentOption();
						renderAnimation();
					}
					else
					{
						doubleClickTimer = new FlxTimer().start
						(
							isMobile ? 0.5 : 0.35,
							()->
							{
								doubleClickTimer.destroy();
								doubleClickTimer = null;
							}
						);
					}
				case (SwipeUtil.swipeUp):
					if (!TouchUtil.overlaps(modifiersHitboxLeft, camera) && !TouchUtil.overlaps(modifiersHitboxDown, camera)) return;
					selectButton(FlxMath.bound(selected_button - 1, 0, buttons.length - 1));
				case (SwipeUtil.swipeDown):
					if (!TouchUtil.overlaps(modifiersHitboxLeft, camera) && !TouchUtil.overlaps(modifiersHitboxDown, camera)) return;
					selectButton(FlxMath.bound(selected_button + 1, 0, buttons.length - 1));
				case (SwipeUtil.swipeLeft):
					if (!TouchUtil.overlaps(optionsSliderHitbox, camera)) return;
					HapticUtil.vibrate(0.15, 0.01, 0.06);
					switchCurrentOption(true, FlxG.keys.pressed.CONTROL);
				case (SwipeUtil.swipeRight):
					if (!TouchUtil.overlaps(optionsSliderHitbox, camera)) return;
					HapticUtil.vibrate(0.15, 0.01, 0.06);
					switchCurrentOption(false, FlxG.keys.pressed.CONTROL);
				case (leftPress):
					rightFirst = false;
					HapticUtil.vibrate(0.1, 0.02, 0.16);
					switchCurrentOption(false, FlxG.keys.pressed.CONTROL);
					manageHoldTimer(true);
				case (rightPress):
					rightFirst = true;
					HapticUtil.vibrate(0.1, 0.02, 0.16);
					switchCurrentOption(true, FlxG.keys.pressed.CONTROL);
					manageHoldTimer(true);
				case (leftRelease):
					manageHoldTimer(false);
				case (rightRelease):
					manageHoldTimer(false);
				case (upPress):
					downFirst = false;
					manageHoldTimer(true);
					if (!FlxG.keys.pressed.CONTROL)
					{
						selectButton(FlxMath.wrap(selected_button - 1, 0, buttons.length - 1));
					}
					else
					{
						selectButton(0);
					}
				case (downPress):
					downFirst = true;
					manageHoldTimer(true);
					if (!FlxG.keys.pressed.CONTROL)
					{
						selectButton(FlxMath.wrap(selected_button + 1, 0, buttons.length - 1));
					}
					else
					{
						selectButton(buttons.length-1);
					}
				case (upRelease):
					manageHoldTimer(false);
				case (downRelease):
					manageHoldTimer(false);
				case (doHoldUp):
					if (justHeld)
					{
						justHeld = false;
						selectButton(FlxMath.wrap(selected_button - 1, 0, buttons.length - 1));
					}
				case (downHold):
					if (justHeld)
					{
						justHeld = false;
						selectButton(FlxMath.wrap(selected_button + 1, 0, buttons.length - 1));
					}
				case (doHoldLeft):
					if (justHeld)
					{
						justHeld = false;
						switchCurrentOption(false, false);
					}
				case (rightHold):
					if (justHeld)
					{
						justHeld = false;
						switchCurrentOption(true, false);
					}
				case (FlxG.keys.justPressed.HOME):
					selectButton(0);
				case (FlxG.keys.justPressed.END):
					selectButton(buttons.length-1);
				case (can_exit):
					if (controls.get_BACK() || GammodControls.justPressed('modifiers'))
					{
						goToFreeplay();
					}
			}
		}
		var resetCondition = Gammod.mobile() ? FlxG.keys.justPressed.TAB || (TouchUtil.justPressed && TouchUtil.overlaps(resetModsHitbox, camera)) : FlxG.keys.justPressed.TAB;
		var resetCancelCondition = Gammod.mobile() ? FlxG.keys.justReleased.TAB || (TouchUtil.justReleased) : FlxG.keys.justReleased.TAB;
		switch (true)
		{
			case resetCondition:
				if (transitioningOut) return;
				allow_input = false;
				disableModsOn.color = 0xFFFFFFFF;

				Tweens.cancel('decelerate_upBackdrop');
				Tweens.cancel('decelerate_downBackdrop');

				if (focusSound.isPlaying) focusSound.pause();
				focusSound.volume = 0;
				focusSound.play(3 * Math.abs((disableModsOn.clipRect.height / disableModsOff.height) - 1));
				Tweens.cancel('fade_focusSound');
				Tweens.tween(
					'fade_focusSound',
					focusSound,
					{ volume: 1 },
					0.05,
					0,
					'linear'
				);

				if (disableModsProgress != null) disableModsProgress.cancel();
				Tweens.cancel('focus_focusTint');
				Tweens.tween(
					'focus_focusTint',
					focusTint,
					{ alpha: 0.8 },
					3 * Math.abs((disableModsOn.clipRect.height / disableModsOff.height) - 1),
					0,
					'linear'
				);
				Tweens.cancel('focus_backdropCamera');
				Tweens.tween(
					'focus_backdropCamera',
					backdropCamera,
					{ zoom: 1.1 },
					3 * Math.abs((disableModsOn.clipRect.height / disableModsOff.height) - 1),
					0,
					'quadIn'
				);
				Tweens.cancel('focus_backgroundCamera');
				Tweens.tween(
					'focus_backgroundCamera',
					backgroundCamera,
					{ zoom: 1.1 },
					3 * Math.abs((disableModsOn.clipRect.height / disableModsOff.height) - 1),
					0,
					'quadIn'
				);
				Tweens.cancel('focus_camera');
				Tweens.tween(
					'focus_camera',
					FlxG.state.subState.funnyCam,
					{ zoom: 1.2 },
					3 * Math.abs((disableModsOn.clipRect.height / disableModsOff.height) - 1),
					0,
					'quadIn'
				);
				Tweens.cancel('fade_music');
				Tweens.tween(
					'fade_music',
					FlxG.sound.music,
					{ volume: 0.2 },
					3 * Math.abs((disableModsOn.clipRect.height / disableModsOff.height) - 1),
					0,
					'linear'
				);
				disableModsProgress = FlxTween.num
				(
					disableModsOn.clipRect.height,
					disableModsOff.height,
					3 * Math.abs((disableModsOn.clipRect.height / disableModsOff.height) - 1),
					{
						onComplete: () ->
						{
							if (focusSound.isPlaying) focusSound.pause();
							FunkinSound.playOnce(Paths.sound('resetModsDone'));
							FlxG.sound.music.volume = 1;
							screenCam.shake(0.01,0.2);
							HapticUtil.vibrate(1, 0.5, 0.27);
							upperBackdropTxt.velocity.x = 20;
							bottomBackdropTxt.velocity.x = -20;
							Tweens.cancel('focus_backgroundCamera');
							Tweens.tween(
								'focus_backgroundCamera',
								backgroundCamera,
								{ zoom: 1 },
								0.3,
								0,
								'circOut'
							);
							Tweens.cancel('focus_backdropCamera');
							Tweens.tween(
								'focus_backdropCamera',
								backdropCamera,
								{ zoom: 1 },
								0.3,
								0,
								'circOut'
							);

							var current_button: Int = 0;
							for (mod in buttons)
							{
								mod.removeOn(true);
								if (mod.assigned_mod.type == GammodModType.SWITCH)
								{
									mod.assigned_mod.value = mod.assigned_mod.pre_default != null ? mod.assigned_mod.pre_default : mod.assigned_mod.default_value;
								}
								else
								{
									mod.assigned_mod.value = mod.assigned_mod.pre_default != null ? mod.assigned_mod.pre_default : mod.assigned_mod.default_value;
								}
								saveValue(current_button);
								current_button += 1;
							}

							refreshCurrentOption();
							renderAnimation();
							Tweens.cancel('focus_focusTint');
							Tweens.tween(
								'focus_focusTint',
								focusTint,
								{ alpha: 0 },
								0.1,
								0,
								'circOut'
							);
							Tweens.cancel('focus_camera');
							Tweens.tween(
								'focus_camera',
								FlxG.state.subState.funnyCam,
								{ zoom: 1 },
								0.1,
								0,
								'circOut'
							);
							disableModsOn.clipRect = new FlxRect(0, 0, disableModsOn.width, 0);
						}
					},
					(value) ->
					{
						upperBackdropTxt.velocity.x = 20 * FlxMath.bound(value, 1, null);
						bottomBackdropTxt.velocity.x = -20 * FlxMath.bound(value, 1, null);
						disableModsOn.clipRect = new FlxRect(0, 0, disableModsOn.width, FlxMath.remapToRange(value, 0, disableModsOff.height, 13, disableModsOff.height-12));
					}
				);
			case resetCancelCondition:
				if (disableModsOn.clipRect.height < 30 && disableModsOn.clipRect.height != 0)
				{
					Tweens.cancel('recolor_arrowOffRight');
					Tweens.cancel('recolor_arrowOnRight');
					Tweens.cancel('recolor_arrowOffLeft');
					Tweens.cancel('recolor_arrowOnLeft');
					Tweens.cancel('recolor_optionTxt');
					Tweens.cancel('recolor_optionTxt2');
					Tweens.cancel('recolor_optionTxt3');
					
					optionTxt.text = 'HOLD THE BUTTON';
					optionTxt.color = 0xFFFF0000;
					borderColor.color = 0xFF000000;
					screenCam.shake(0.01,0.2);
					refreshCurrentOption(false, true);
					HapticUtil.vibrate(0.01, 0.02, 0.27);

					leftSelectorArrow.setColor(0xFF660000);
					rightSelectorArrow.setColor(0xFF660000);

					FunkinSound.playOnce(Paths.sound('resetModsError'));
				}

				if (!transitioningOut) allow_input = true;
				disableModsOn.color = 0xFFAAAAAA;

				if (focusSound.isPlaying) focusSound.pause();
				focusSound.volume = 0;

				upperBackdropTxt.velocity.x = 20;
				bottomBackdropTxt.velocity.x = -20;

				if (disableModsProgress != null) disableModsProgress.cancel();
				Tweens.cancel('focus_focusTint');
				Tweens.tween(
					'focus_focusTint',
					focusTint,
					{ alpha: 0 },
					0.1,
					0,
					'circOut'
				);
				Tweens.cancel('focus_backgroundCamera');
				Tweens.tween(
					'focus_backgroundCamera',
					backgroundCamera,
					{ zoom: 1 },
					0.3,
					0,
					'circOut'
				);
				Tweens.cancel('focus_backdropCamera');
				Tweens.tween(
					'focus_backdropCamera',
					backdropCamera,
					{ zoom: 1 },
					0.3,
					0,
					'circOut'
				);
				Tweens.cancel('focus_camera');
				Tweens.tween(
					'focus_camera',
					FlxG.state.subState.funnyCam,
					{ zoom: 1 },
					0.1,
					0,
					'circOut'
				);
				disableModsOn.clipRect = new FlxRect(0, 0, disableModsOn.width, 0);
				Tweens.cancel('fade_music');
				FlxG.sound.music.volume = 1;
		}
	}

	private function manageHoldTimer(on:Bool):Void
	{
		if (on)
		{
			justHeld = false;
			if (holdTimer != null) 
			{
				holdTimer.cancel();
				holdTimer.destroy();
				holdTimer = null;
			}
			if (holdingLoop != null) 
			{
				holdingLoop.cancel();
				holdingLoop.destroy();
				holdingLoop = null;
			}
			holdTimer = new FlxTimer().start
			(
				0.5,
				()->
				{
					holdTimer.destroy();
					holdTimer = null;
					holdingLoop = FlxTimer.loop
					(
						0.07,
						()->
						{
							justHeld = true;
						}
					);
				}
			);
		}
		else
		{
			justHeld = false;
			if (holdingLoop != null) 
			{
				holdingLoop.cancel();
				holdingLoop.destroy();
				holdingLoop = null;
			}
		}
	}

	private function goToFreeplay():Void
	{
		trace('Closing the menu has been requested. Beginning transition.');

		transitioningIn = false;

		FlxG.state.subState.persistentDraw = true;

		if (Gammod.mobile() && backButton != null) backButton.enabled = false;
		allow_input = false;
		transitioningOut = true;
		arrow_hover = false;
		can_write_desc = false;

		bg.cameras = [FlxG.state.subState.funnyCam];

		backdropCamera.alpha = 0;
		bg.color = 0xFFFFFFFF;
		Tweens.cancel('flash_bg');
		Tweens.cancel('fade_bg');
		Tweens.tween(
			'fade_bg',
			bg,
			{ alpha: 0 },
			0.3,
			0,
			'sineOut'
		);
		Tweens.cancel('fadeIn_transitionTint');
		Tweens.tween(
			'fadeIn_transitionTint',
			transitionTint,
			{ alpha: 0.5 },
			0.3,
			0,
			'sineOut'
		);

		hideUnranked();

		if (ModuleHandler.getModule('GammodFreeplayModule').multCard.multTxt.alpha == 0) ModuleHandler.getModule('GammodFreeplayModule').multCard;
		ModuleHandler.getModule('GammodFreeplayModule').updateModCount();

		//ModuleHandler.getModule('GammodFreeplayModule').modifyMenu(!ModuleHandler.getModule('GammodModifierHandler').updateModsOn());

		Tweens.cancel('fade_transitionTint');
		Tweens.tween(
			'fade_transitionTint',
			transitionTint,
			{ alpha: 0 },
			0.3,
			0.4,
			'sineOut'
		);

		Tweens.cancel('moveTrans_bottomBand');
		Tweens.tween(
			'moveTrans_bottomBand',
			bottomBand,
			{ y: FlxG.height + (multScreen.height - 10) },
			0.3,
			0,
			'sineIn'
		);

		Tweens.cancel('moveTrans_funTxt');
		Tweens.tween(
			'moveTrans_funTxt',
			funTxt,
			{ y: FlxG.height + (FlxG.height-bottomBand.y) },
			0.3,
			0,
			'sineIn'
		);

		Tweens.cancel('moveTrans_descBorder');
		Tweens.tween(
			'moveTrans_descBorder',
			descBorder,
			{ y: FlxG.height + (multScreen.height - 10) },
			0.3,
			0,
			'sineIn'
		);

		Tweens.cancel('move_selectedArrow');
		Tweens.tween(
			'move_selectedArrow',
			selectedArrow,
			{ x: -200 },
			0.2,
			0.33,
			'circIn',
			'oneshot',
			function ()
			{
				arrow_hover = true;
			}
		);

		Tweens.cancel('appear_multScreen');
		Tweens.tween(
			'appear_multScreen',
			multScreen,
			{ y: FlxG.height },
			0.3,
			0,
			'sineIn'
		);

		Tweens.cancel('appear_multNum');
		Tweens.tween(
			'appear_multNum',
			multiplierNum,
			{ y: FlxG.height + 11 },
			0.3,
			0,
			'sineIn'
		);

		Tweens.cancel('appear_multNumGlow');
		Tweens.tween(
			'appear_multNumGlow',
			multiplierNumGlow,
			{ y: FlxG.height + 11 },
			0.3,
			0,
			'sineIn'
		);

		Tweens.cancel('appear1x_optionTxt');
		Tweens.cancel('appear1y_optionTxt');
		Tweens.cancel('appear2_optionTxt');
		Tweens.tween(
			'appear_optionTxt',
			optionTxt,
			{ y: -100 },
			0.3,
			0.2,
			'quadIn'
		);

		if (slideLapTimer != null) 
		{
			slideLapTimer.cancel();
			slideLapTimer.destroy();
		}
		if (unrankedBumpTimer != null)
		{
			unrankedBumpTimer.cancel();
			unrankedBumpTimer.destroy();
			unrankedBumpTimer = null;
		}

		Tweens.cancel('moveTrans_sideBar');
		Tweens.tween(
			'moveTrans_sideBar',
			sideBar,
			{ x: -sideBar.width },
			0.45,
			0,
			'quintIn'
		);

		/*Tweens.cancel('slide_mods');
		Tweens.cancel('slide_modsB');
		Tweens.tween(
			'slide_mods',
			sideTextMods,
			{ x: -sideTextMods.width },
			0.45,
			0,
			'quintIn'
		);
		Tweens.tween(
			'slide_modsB',
			sideTextModsB,
			{ x: -sideTextModsB.width },
			0.45,
			0,
			'quintIn'
		);

		Tweens.cancel('slide_play');
		Tweens.cancel('slide_playB');
		Tweens.tween(
			'slide_play',
			sideTextPlay,
			{ x: -sideTextPlay.width },
			0.45,
			0,
			'quintIn'
		);
		Tweens.tween(
			'slide_playB',
			sideTextPlayB,
			{ x: -sideTextPlayB.width },
			0.45,
			0,
			'quintIn'
		);*/

		Tweens.cancel('moveTrans_topBand');
		Tweens.tween(
			'moveTrans_topBand',
			topBand,
			{ y: -topBand.height },
			0.6,
			0,
			'quintIn'
		);

		Tweens.cancel('moveTrans_screenCam');
		Tweens.tween(
			'moveTrans_screenCam',
			screenCam,
			{ y: -200 },
			0.6,
			0,
			'quintIn'
		);

		Tweens.cancel('appear_players');
		Tweens.cancel('diss_a_pear_players');
		Tweens.tween(
			'diss_a_pear_players',
			players,
			{ y: FlxG.height + 30 },
			0.5,
			0.1,
			'expoIn'
		);

		Tweens.cancel('recolor_bg');
		Tweens.cancel('fadeTrans_bg');
		Tweens.cancel('fadeTrans2_bg');
		Tweens.tween(
			'fadeTrans_bg',
			bg,
			{ y: -bg.height },
			0.7,
			0,
			'quintIn'
		);
		/*Tweens.color(
			'fadeTrans2_bg',
			bg,
			0xFF000000,
			0.7,
			0,
			'linear'
		);*/

		for (visibleButton in 0...7)
		{
			new FlxTimer().start
			(
				(visibleButton * 0.12) + 0.05, 
				()->
				{
					if (buttons[(visibleButton + (selected_button - 3))] != null)
					{
						buttons[(visibleButton + (selected_button - 3))].popOut();
						FunkinSound.playOnce(Paths.sound('buttonDisappear/' + (visibleButton+1)));
					}
				}
			);
			new FlxTimer().start
			(
				(visibleButton * 0.1), 
				()->
				{
					if (buttons[(visibleButton + (selected_button - 3))] != null)
					{
						Tweens.cancel('fade_sticker' + buttons[(visibleButton + (selected_button - 3))].ID);
						Tweens.tween(
							'fade_sticker' + buttons[(visibleButton + (selected_button - 3))].ID,
							buttons[(visibleButton + (selected_button - 3))].defaultSticker,
							{ alpha: 0 },
							0.1,
							0,
							'quadOut'
						);
						Tweens.cancel('fade_icon' + buttons[(visibleButton + (selected_button - 3))].ID);
						Tweens.tween(
							'fade_icon' + buttons[(visibleButton + (selected_button - 3))].ID,
							buttons[(visibleButton + (selected_button - 3))].defaultIcon,
							{ alpha: 0 },
							0.1,
							0,
							'quadOut'
						);
					}
				}
			);
		}

		new FlxTimer().start
		(
			1.0, 
			()->
			{
				if (unrankedTimer != null)
				{
					unrankedTimer.cancel();
					unrankedTimer.destroy();
					unrankedTimer = null;
				}

				if (shaderTimer != null)
				{
					shaderTimer.cancel();
					shaderTimer.destroy();
					shaderTimer = null;
				}

				FlxG.cameras.remove(backgroundCamera);
				FlxG.cameras.remove(backdropCamera);

	     		super.close();
				ModuleHandler.getModule('GammodStateHandler').closeGammodMenu();
				ModuleHandler.getModule('GammodStateHandler').remembered_mod_position = selected_button;
				ModuleHandler.getModule('GammodFreeplayModule').mod_menu_open = false;
				if (FlxG.sound.music != null) FlxG.sound.music.stop();
				FlxG.state.subState.playCurSongPreview();
				if (Gammod.mobile()) FlxG.state.subState.backButton.visible = true;
			}
		);
	}

	public function refresh()
	{
		
	}
}