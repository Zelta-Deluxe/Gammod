		multiplierNum.shader.set_shakePower(0);
		multiplierNum.scale.set(0.89,1);

		multiplierNumGlow = new FlxText(0,0, 0, ModuleHandler.getModule('GammodMult').score_multiplier, 1, true).setFormat(Paths.file('fonts/fanfareticker.ttf', 'FONT'), 37, 0xFF66ffff);
		if (Math.floor(ModuleHandler.getModule('GammodMult').score_multiplier) == ModuleHandler.getModule('GammodMult').score_multiplier)
