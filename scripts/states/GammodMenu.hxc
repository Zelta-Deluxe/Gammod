class GammodModButton extends FlxTypedSpriteGroup
{
	var icon: FunkinSprite;
	var screenTxt: CapsuleText;
	var initialsTxt: CapsuleText;
	var buttonBackground: FunkinSprite;
	var defaultSticker: FunkinSprite;
	var soundTimer: FlxTimer;
	var defaultIcon: FunkinSprite;

	var glitchShakeEffect: GlitchShake;

	var spacing: Vector2 = new Vector2(20,20);
	var assigned_mod: Module;
	var selected: Bool = false;
	var currently_default: Bool = true;
	var currently_unranked: Bool = false;
	var defaultIcon_scale:Float = 0.13;

	var original_width: Int; // My mistake, original gangster!
	var original_height: Int;

	public function new(mod:Module)
	{
		super();

		var initials: String = mod.display_name.split(' ').map
		(
			member -> 
			{
				return member.substr(0,1);
			}
		).join().toUpperCase();

		glitchShakeEffect = new GlitchShake();
		glitchShakeEffect.update(1, 1.2);

		initialsTxt = new CapsuleText(0, 0, initials, 50);
		initialsTxt.set_clipWidth(255);
		initialsTxt.glowColor = mod.colors[0];
		initialsTxt.blurredText.color = mod.colors[0];
    		initialsTxt.whiteText.textField.filters = [new GlowFilter(mod.colors[0], 1, 5, 5, 210, 2)];
		this.add(initialsTxt);

		buttonBackground = new FunkinSprite(0,0).loadGraphic(Paths.image('ui/gammodMenu/buttonOverlay'));
		buttonBackground.offset.set(buttonBackground.width, 0);
		buttonBackground.x = -20;
		buttonBackground.y += 10;
		this.add(buttonBackground);

		icon = new FunkinSprite(spacing.x,spacing.y);
		if (Assets.exists(Paths.image('ui/gammodMenu/icons/' + mod.moduleId))) 
		{
			icon.loadGraphic(Paths.image('ui/gammodMenu/icons/' + mod.moduleId));
		}
		else
		{
			icon.loadGraphic(Paths.image('ui/gammodMenu/icons/Default'));
		}
		original_width = icon.width;
		original_height = icon.height;
		icon.antialiasing = false;
		icon.origin.set(0,0);
		icon.scale.set((76/icon.width), (76/icon.height));
		icon.origin.set(icon.width / 2, icon.height / 2);
		icon.updateHitbox();
		icon.shader = glitchShakeEffect;
		this.add(icon);

		defaultIcon = new FunkinSprite(0,0);
		defaultIcon.frames = Paths.getSparrowAtlas('ui/gammodMenu/onStickerIcon');
		defaultIcon.animation.addByPrefix('on', 'onStickerIcon on', 15, true);
		defaultIcon.animation.addByPrefix('nr', 'onStickerIcon unranked', 15, true);
		defaultIcon.animation.addByPrefix('mult', 'onStickerIcon mult', 15, true);
		defaultIcon.animation.play('on', true);
		defaultIcon.antialiasing = true;
		defaultIcon.origin.set(0,0);
		defaultIcon.scale.set(0.2,0.2);
		defaultIcon.alpha = 0;
		defaultIcon.origin.set(defaultIcon.width / 2, defaultIcon.height / 2);
		defaultIcon.updateHitbox();
		this.add(defaultIcon);

		initialsTxt.x = icon.x + icon.width + spacing.x;
		initialsTxt.y = (icon.y + (icon.height - initialsTxt.height) / 2);

		screenTxt = new CapsuleText(icon.x + icon.width + spacing.x,icon.y, mod.display_name, 50);
		screenTxt.set_clipWidth(0); // REMAINING TO DO SOME MATH TO CLIP EVERYTHING CORRECTLY SO IF SOMEONE DOES A REALLY LONG NAME IT DOESN'T FUCK UP!!
		screenTxt.y = (icon.y + (icon.height - screenTxt.height) / 2);
		screenTxt.glowColor = mod.colors[0];
		screenTxt.blurredText.color = screenTxt.glowColor;
    		screenTxt.whiteText.textField.filters = [new GlowFilter(screenTxt.glowColor, 1, 5, 5, 210, 2)];
		this.add(screenTxt);

		defaultSticker = new FunkinSprite(0,0);
		defaultSticker.frames = Paths.getSparrowAtlas('ui/gammodMenu/onSticker');
		defaultSticker.animation.addByPrefix('on', 'onSticker on', 15, true);
		defaultSticker.animation.addByPrefix('nr', 'onSticker unranked', 15, true);
		defaultSticker.animation.addByPrefix('mult', 'onSticker mult', 15, true);
		defaultSticker.animation.play('on', true);
		defaultSticker.scale.set(0,0);
		defaultSticker.updateHitbox();
		defaultSticker.scale.set(defaultIcon_scale, defaultIcon_scale);
		defaultSticker.x = 250;
		defaultSticker.y += 57;
		defaultSticker.alpha = 0;
		this.add(defaultSticker);

		assigned_mod = mod;

		this.height = icon.height + (spacing * 2);
	}

	public function update(elapsed:Float)
	{
		defaultIcon.x = icon.x;
		screenTxt.set_clipWidth(FlxMath.bound(-(screenTxt.x - buttonBackground.x), 0, null));

		if (!selected)
		{
			glitchShakeEffect.update(elapsed);
			glitchShakeEffect.set_shakeRate(0.2);
			glitchShakeEffect.set_colorRate(0);
			initialsTxt.alpha = FlxG.random.float(0.05,0.75);
		}
		else
		{
			glitchShakeEffect.set_shakeRate(0);
			glitchShakeEffect.set_colorRate(0);
			initialsTxt.alpha = 1;
		}
	}

	public function updateDefault()
	{
		final is_default:Bool = ModuleHandler.getModule('GammodModifierHandler').checkDefault(assigned_mod);
		final is_unranked = (GammodMult.getMult(assigned_mod) == null);
		if (is_default && !currently_default)
		{
			removeOn();
		}
		else if ((!is_default && currently_default) || ((is_unranked != currently_unranked) && !is_default))
		{
			appendOn(false, is_unranked);
		}
	}

	public function appendOn(block_input: Bool = false, unranked: Bool = false)
	{
		trace('APPLYING STICKER');
		trace('IT IS INDEED, ' + (unranked ? 'UNRANKED' : 'RANKED'));
		if (ModuleHandler.getModule('GammodStateHandler').gammodMenu != null && block_input)
		{
			ModuleHandler.getModule('GammodStateHandler').gammodMenu.allow_input = false;
			new FlxTimer().start
			(
				0.25, 
				()->
				{ 
					if (!ModuleHandler.getModule('GammodStateHandler').gammodMenu.transitioningOut) ModuleHandler.getModule('GammodStateHandler').gammodMenu.allow_input = true;
				}
			);
		}
		currently_default = false;
		currently_unranked = unranked;
		defaultIcon.angle = 0;
		defaultSticker.angle = 65;
		var anim: String = unranked ? 'nr' : (GammodMult.getMult(assigned_mod) != 0.0 ? 'mult' : 'on');
		defaultSticker.animation.play(anim, true);
		defaultIcon.animation.play(anim, true);
		defaultSticker.x = (icon.x + icon.width + screenTxt.width + (spacing.x * 6)) - 35;
		defaultSticker.y = buttonBackground.y + 47;
		defaultSticker.scale.set(0.5, 0.5);
		Tweens.cancel('popIn_sticker' + this.ID);
		Tweens.tween(
			'popIn_sticker' + this.ID,
			defaultSticker,
			{ angle: 0 },
			0.25,
			0,
			'quadIn'
		);
		Tweens.cancel('scaleIn_sticker' + this.ID);
		Tweens.tween(
			'scaleIn_sticker' + this.ID,
			defaultSticker.scale,
			{ x: defaultIcon_scale, y: defaultIcon_scale },
			0.25,
			0,
			'circIn'
		);
		if (selected)
		{
			Tweens.cancel('fadeIn_sticker' + this.ID);
			Tweens.tween(
				'fadeIn_sticker' + this.ID,
				defaultSticker,
				{ alpha: 1 },
				0.12,
				0,
				'quadOut'
			);
			soundTimer = new FlxTimer().start
			(
				0.25, 
				()->
				{
					FunkinSound.playOnce(Paths.sound('stickerStamp'), 8);
				}
			);
		} 
		else
		{
			Tweens.cancel('fade_onIcon' + this.ID);
			Tweens.tween(
				'fade_onIcon' + this.ID,
				defaultIcon,
				{ alpha: 1 },
				0.08,
				0,
				'circOut'
			);
		}
	}

	public function removeOn(block_input: Bool = false)
	{
		trace('HIDING STICKER');
		if (ModuleHandler.getModule('GammodStateHandler').gammodMenu != null && block_input)
		{
			ModuleHandler.getModule('GammodStateHandler').gammodMenu.allow_input = false;
			new FlxTimer().start
			(
				0.12, 
				()->
				{ 
					if (!ModuleHandler.getModule('GammodStateHandler').gammodMenu.transitioningOut) ModuleHandler.getModule('GammodStateHandler').gammodMenu.allow_input = true;
				}
			);
		}
		currently_default = true;
		defaultIcon.angle = 5;
		defaultSticker.angle = 5;
		defaultSticker.y = buttonBackground.y + 40;
		Tweens.cancel('popIn_sticker' + this.ID);
		Tweens.cancel('fadeIn_sticker' + this.ID);
		Tweens.tween(
			'popOut_sticker' + this.ID,
			defaultSticker,
			{ y: defaultSticker.y + 10, alpha: 0 },
			0.12,
			0,
			'quadIn'
		);
		Tweens.cancel('fade_onIcon' + this.ID);
		Tweens.cancel('popOut_deafultIcon' + this.ID);
		Tweens.tween(
			'popOut_deafultIcon' + this.ID,
			defaultIcon,
			{ alpha: 0 },
			0.12,
			0,
			'quadIn'
		);
		if (soundTimer != null)
		{
			soundTimer.cancel();
		}
		FunkinSound.playOnce(Paths.sound('stickerRip'), 8);
	}

	public function popOut()
	{
		Tweens.tween(
			'popOut_overlay' + this.ID,
			this.scale,
			{ y: 0, x: 5 },
			0.12,
			0,
			'circOut'
		);
		Tweens.tween(
			'popOut_overlayText' + this.ID,
			this.screenTxt,
			{ x: -(this.screenTxt.width + 50) },
			0.12,
			0,
			'circOut'
		);
		Tweens.tween(
			'popOut_overlayTextPreview' + this.ID,
			this.initialsTxt,
			{ x: -(this.initialsTxt.width + 50) },
			0.12,
			0,
			'circOut'
		);
	}

	public function pullUpOverlay()
	{
		if (selected) return;
		selected = true;
		buttonBackground.x = 0;

		defaultSticker.y = buttonBackground.y + 47; //REALLY FUCKED UP PATCH, I HAVE TO FIX THIS FROM THE ROOT
		
		Tweens.cancel('move_overlay' + this.ID);
		Tweens.tween(
			'move_overlay' + this.ID,
			buttonBackground,
			{ x: (icon.x + icon.width + screenTxt.width + (spacing.x * 6)) + 66 },
			0.2,
			0,
			'circOut'
		);
		Tweens.cancel('scale_overlay' + this.ID);
		Tweens.tween(
			'scale_overlay' + this.ID,
			icon.scale,
			{ x: (76/original_width) - (0.1 * (icon.width/original_width)), y: (76/original_height) - (0.1 * (icon.height/original_height)) },
			0.2,
			0,
			'circOut'
		);

		if (!currently_default)
		{
			defaultSticker.x = (icon.x + icon.width + screenTxt.width + (spacing.x * 6)) - 300;
			Tweens.cancel('move_sticker' + this.ID);
			Tweens.tween(
				'move_sticker' + this.ID,
				defaultSticker,
				{ x: (icon.x + icon.width + screenTxt.width + (spacing.x * 6)) + 13, angle: 360, alpha: 1 },
				0.2,
				0,
				'circOut'
			);
			Tweens.cancel('fade_onIcon' + this.ID);
			Tweens.tween(
				'fade_onIcon' + this.ID,
				defaultIcon,
				{ alpha: 0 },
				0.08,
				0,
				'circOut'
			);
		}
	}

	public function pullDownOverlay()
	{
		if (!selected) return;
		selected = false;
		buttonBackground.x = icon.x + icon.width + screenTxt.width + (spacing.x * 4);
		Tweens.cancel('move_overlay' + this.ID);
		Tweens.tween(
			'move_overlay' + this.ID,
			buttonBackground,
			{ x: 0 },
			0.2,
			0,
			'circOut'
		);
		Tweens.cancel('scale_overlay' + this.ID);
		Tweens.tween(
			'scale_overlay' + this.ID,
			icon.scale,
			{ x: (76/original_width), y: (76/original_height) },
			0.2,
			0,
			'circOut'
		);

		if (!currently_default)
		{
			Tweens.cancel('move_sticker' + this.ID);
			Tweens.tween(
				'move_sticker' + this.ID,
				defaultSticker,
				{ x: (icon.x + icon.width + screenTxt.width + (spacing.x * 6)) - 300, angle: 0, alpha: 0 },
				0.2,
				0,
				'circOut'
			);
			Tweens.cancel('fade_onIcon' + this.ID);
			Tweens.tween(
				'fade_onIcon' + this.ID,
				defaultIcon,
				{ alpha: 1 },
				0.08,
				0,
				'circOut'
			);
		}
	}

	public function refresh()
	{
		
	}
}

class GammodSelectorArrow extends FlxTypedSpriteGroup
{
	var offTexture: FunkinSprite;
	var onTexture: FunkinSprite;

	var left: Bool;

	var glitchTimer: FlxTimer;

	var previous_pressed: Bool;

	public function new(_left: Bool)
	{
		super();
		
		left = _left;
	}

	public function init(_x: Int, _y: Int): GammodSelectorArrow
	{
		offTexture = new FunkinSprite(0,0).loadGraphic(Paths.image('ui/gammodMenu/optionsScreen_arrowOff'));
		offTexture.shader = new GlitchShake(null, true);
		onTexture = new FunkinSprite(0,0).loadGraphic(Paths.image('ui/gammodMenu/optionsScreen_arrowOn'));
		onTexture.alpha = 0;
		onTexture.shader = new GlitchShake(null, true);

		offTexture.shader.set_shakeRate(10);
		onTexture.shader.set_shakeRate(10);

		color = 0xFF66FFFF;

		this.add(offTexture);
		this.add(onTexture);

		if (!left)
		{
			this.flipX = true;
		}

		x = _x;
		y = _y;

		setColor(0xFF66FFFF);

		return this;
	}

	public function setColor(value:Int)
	{
		offTexture.shader.set_color(value);
		onTexture.shader.set_color(value);
	}

	public function update(pressed: Bool, ?elapsed:Float = 0)
	{
		onTexture.alpha = pressed ? 1 : 0;
		offTexture.shader.update(elapsed);
		onTexture.shader.update(elapsed);
	}
}

class GammodMenu extends ScriptedMusicBeatSubState
{
	//var controls: Controls = PlayerSettings.player1.controls;
	var buttons: Array<GammodModButton> = [];
	var buttonsCam: FunkinCamera; 
	var buttonGroup: FlxTypedSpriteGroup;
	var freeplayScoreTxt: FreeplayScore;
	var bg: FunkinSprite;
	var selectedArrow: FlxTypedSpriteGroup;
	var topBand: FunkinSprite;
	var bottomBand: FunkinSprite;
	var sideBar: FunkinSprite;

	//--SHADER STUFF
	var extraSpeed:Float = 1;
	var extraSpeedPeak:Float = 10;
	var extraSpeedChange:FlxTween;
	var introProgress:Float = 0;
	var introProgressChange:FlxTween;

	// THINGS FOR THE MULTIPLIERS SCREEN THONG (what)!!!
	var multiplierNum: FlxText;
	var multiplierNumGlow:FlxText;
	var multScreen: FunkinSprite;

	// THINGS FOR THE OPTIONS SCREEN THING!!!
	var optionsScreen: FunkinSprite;
	var optionTxt: FlxText;
	var tipTxt: FlxText;

	var optionsLights: FlxTypedSpriteGroup;
	var lightsOff: FunkinSprite;
	var lightsOn: FunkinSprite;
	var lightsTimer: FlxTimer;

	var leftSelectorArrow: GammodSelectorArrow;
	var rightSelectorArrow: GammodSelectorArrow;

	var disableModsOff: FunkinSprite;
	var disableModsOn: FunkinSprite;
	var disableModsProgress: FlxTween;
	var focusTint: FunkinSprite;
	var focusSound: FunkinSound;

	var textAnimator: FlxTween;
	var borderColor: FlxSprite;

	var modifiersHitboxLeft: FlxSprite;
	var modifiersHitboxDown: FlxSprite;
	var optionsSliderHitbox: FlxSprite;
	var leftArrowHitbox: FlxSprite;
	var rightArrowHitbox: FlxSprite;
	var resetModsHitbox: FlxSprite;

	var descBorder: FlxSprite;

	var funTxt: FlxText;

	var slideLapTimer: FlxTimer;

	var doubleClickTimer: FlxTimer;
	var holdTimer: FlxTimer;
	var holdingLoop: FlxTimer;
	var textWriteTimer: FlxTimer;
	var unrankedBumpTimer: FlxTimer;

	// New camera that stores all the stuff for the top screen (mainly to do a zoom effect later on and move it as a whole sprite)
	var screenCam: FunkinCamera;

	var renderSound: FunkinSound;
	var renderSound_step: Int = 1;

	var hitbox_amplitude: Int = 30;

	var selected_offset: Int = 50;
	var deselected_position: Int = 0;
	var button_spacing: Int = 20;

	var arrow_interval: Int = 50;
	var arrow_counter: Float = 0;
	var arrow_hover: Bool = false;

	var optionsTxt_center: Int = 850;

	var text_hoffset: Int = 120;

	var selected_button: Int;
	var allow_input: Bool = false;
	var transitioningOut: Bool = false;
	var transitioningIn: Bool = true;

	var screen_elemets_offset: Int = 80;
	var scale_options_multiplier: Float = 1.0;

	var appear_delay = 0.3;

	var slide_speed = 6;

	/*
	 * Automatically set to true when you hold!
	 * Must be consumed when used (so you set it back to false, plaese..)
	 */
	var justHeld:Bool = false;

	var rendering_animation: Bool = false;

	var can_write_desc: Bool = false;
	var writing_animation: Bool = false;

	var desc_progress: Int = 1;
	var desc_content: String = '';

	var text_tint:Int = 0xFF666666;
	var introduced_mods_text: FlxText;
	var introduced_play_text: FlxText;
	var visible_mods_text: FlxText;
	var visible_play_text: FlxText;

	var scoreWontSave: FunkinSprite;

	var shaderTimer: FlxTimer;

	var can_exit: Bool = false;

	var show_tip:Bool = false;

	var showing_unranked: Bool = false;
	var showing_unranked_sign: Bool = false;
	var unrankedTimer: FlxTimer;
	var unranked_text: Bool = false;
	var previous_unranked: Bool;

	var intended_option_color: Int = 0xFF66ffff;

	var needs_unranked:Bool = false;

	var rightFirst:Bool = false;
	var downFirst:Bool = false;

	var players:ModifiersMenuPlayers;

	var upperBarBG:FlxSprite;
	var bottomBarBG:FlxSprite;

	var backgroundCamera:FlxCamera;
	var backdropCamera:FlxCamera;
	var upperBackdropTxt:FlxBackdrop;
	var bottomBackdropTxt:FlxBackdrop;

	var transitionTint:FunkinSprite;

	var glitchOptionTimer:FlxTimer;

	var multLight:FunkinSprite;
	var showing_multLight:Bool = false;

	var unrkPulseTimer:FlxTimer;
	var unrk_pulse_out:Bool = false;

	var MOBILE_MULT_XOFFSET:Int = -200;

	public function new()
    	{
		super();
	}

	public override function create()
	{
		super.create();

		/*
			END POSITIONS:
			- optionTxt; x: (FlxG.width - optionTxt.width) - 5; y: 3;
			- multiplierNum; x: FlxG.width - multiplierNum.width; y: (FlxG.height - multiplierNum.height) + 10;
			- bg; x: FlxG.width - bg.width;
			- bottomBand; x: FlxG.width - bottomBand.width; y: FlxG.height - bottomBand.height;
		*/

		transitionTint = new FunkinSprite().makeGraphic(FlxG.width,FlxG.height, 0xFF000000);
		transitionTint.alpha = 0.2;

		backgroundCamera = new FlxCamera(0, 0, FlxG.width, FlxG.height, 0);
		backgroundCamera.bgColor = 0x00000000;
		FlxG.cameras.insert(backgroundCamera, 1);

		backdropCamera = new FlxCamera(0, 0, FlxG.width, FlxG.height, 0);
		backdropCamera.bgColor = 0x00000000;
		backdropCamera.angle = 4;
		FlxG.cameras.insert(backdropCamera, 2);

		upperBarBG = new FlxSprite();
		upperBarBG.makeGraphic(FlxG.width * 2, 300);
		upperBarBG.angle = 4; //-5
		upperBarBG.x -= 30;
		upperBarBG.y = -400; // -100
		upperBarBG.antialiasing = false;
		upperBarBG.cameras = [backgroundCamera];

		bottomBarBG = new FlxSprite();
		bottomBarBG.makeGraphic(FlxG.width * 2, 300);
		bottomBarBG.angle = 4; //-5
		bottomBarBG.x -= 30;
		bottomBarBG.y = 800; // 600
		bottomBarBG.antialiasing = false;
		bottomBarBG.cameras = [backgroundCamera];

		upperBackdropTxt = new FlxBackdrop(Paths.image('ui/gammodMenu/backdropTxt'), 0x01, 30, 0);
		upperBackdropTxt.color = 0xffFFB9F4;
		upperBackdropTxt.velocity.x = 200; // 20
		upperBackdropTxt.y = -100; // 50
