// CHECKLIST FOR PLAYTESTERS:
// - Play around half a song, go to the pause and restart. Does the chart match the vocals or are some notes in the incorrect side?

class GammodPlayerSide extends GammodModifier
{
	var inPause:Bool = false;
	var hideChangeDifficulty:Bool = true;

	override public function new()
	{
		super('GammodPlayerSide', GammodModType.LIST(['NORMAL', 'OPPOSITE']), {default_value:'NORMAL'});

		display_name = "Player's Side";
		colors = [0xff9cc2ff,0xff415ee0];
		multiplier = [0.0, 0.0, 0.0];
		description = 'DECIDE WHICH SIDE YOU PLAY';
		banned_songs = ['spaghetti'];

		priority = 69; //heh, nice
	}

	public function onStateChangeEnd(event:StateChangeScriptEvent)
	{
		if (isDefault()) return;
		if (event.targetState is PlayState)
		{
			switch (value)
			{
				case 'OPPOSITE':
					event.targetState.currentStage.getPlayer().characterType = CharacterType.DAD;
					event.targetState.currentStage.getOpponent().characterType = CharacterType.BF;
					event.targetState.scoreText.x = (event.targetState.healthBarBG.x + 90);
					event.targetState.healthBar.fillDirection = FlxBarFillDirection.LEFT_TO_RIGHT;
					event.targetState.iconP1.autoUpdate = false;
					event.targetState.iconP2.autoUpdate = false;

					//var player = event.targetState.currentStage.getPlayer();
					//var opponent = event.targetState.currentStage.getOpponent();
					//player.characterType = CharacterType.DAD;
					//player.characterType = CharacterType.DAD;
					opposeStrumlines();
			}
		}
	}

	public function onSongLoaded(chart:SongLoadScriptEvent) 
	{
		switch (value)
		{
			case 'OPPOSITE':
				opposeChart(chart);
		}
	}

	public function onSongRetry(event:SongRetryEvent) 
	{
		switch (value)
		{
			case 'OPPOSITE':
				if (!difficultyChanged)
				{
					// I might be dumb but
					// shouldn't this be the opposite way?
					// If we change difficulty, the chart changes, so we would have to oppose it, right?
					// idk, weird
					opposeChart(playstate().currentChart);

					if (playstate().currentStage.getPlayer().characterType == CharacterType.BF) 
					{
						// For some reason the player converts into bf type again when you die
						// Here we set it back to DAD as it started
						playstate().currentStage.getPlayer().characterType = CharacterType.DAD;
					}
					if (playstate().currentStage.getOpponent().characterType == CharacterType.DAD) 
					{
						playstate().currentStage.getOpponent().characterType = CharacterType.BF;
					}
				}
		}
	}

	public function onSubStateOpenEnd(event)
	{
		if (event.targetState is PauseSubState)
		{
			inPause = true;
			//trace('OPENED THE MENU');
		}
	}

	public function onSubStateCloseEnd(event)
	{
		if (event.targetState is PauseSubState)
		{
			inPause = false;
			//trace('CLOSED THE MENU');
		}
	}

	public function onCountdownStart(event)
	{
		if (!isDefault()) playstate().vocals.opponentVolume = 1;
	}

	public function onNoteHit(event:HitNoteScriptEvent)
	{
		switch (value)
		{
			case 'OPPOSITE':
				// vocals work a bit funky here,
				// I already tried making the opponent sound be the player one and viceversa, but couldn't for some reason
				playstate().vocals.opponentVolume = 1;
		}
	}

	public function onNoteMiss(event:NoteScriptEvent)
	{
		switch (value)
		{
			case 'OPPOSITE':
				playstate().vocals.opponentVolume = 0;
		}
	}

	public function onNoteHoldDrop(event:HoldNoteScriptEvent)
	{
		switch (value)
		{
			case 'OPPOSITE':
				playstate().vocals.opponentVolume = 0;
				//event.holdNote.noteData.data = giveOppositeData(event.holdNote.noteData.data);
		}
	}

	public function onNoteGhostMiss(event:GhostMissNoteScriptEvent)
	{
		switch (value)
		{
			case 'OPPOSITE':
				event.playAnim = false;
				playstate().vocals.opponentVolume = 0;
		}
	}

	/*
	 * Slice of code ported from source code for maximum accurracy, but modified to work when you're the enemy.
	 */
	public function updateIconPosition(iconId:Int):Void
	{
		if (playstate() != null)
		{
			switch (iconId)
			{
				case 0: // Boyfriend
					playstate().iconP1.updateHealthIcon(2 - playstate().healthBar.value);
					playstate().iconP1.x = playstate().healthBar.x
	 				 + (playstate().healthBar.width * (FlxMath.remapToRange(2 - playstate().healthBar.value, 0, 2, 100, 0) * 0.01) - HealthIcon.POSITION_OFFSET);
					playstate().iconP1.y = playstate().healthBar.y - (playstate().iconP1.height / 2);
				case 1: // Dad
					playstate().iconP2.updateHealthIcon(playstate().healthBar.value);
					playstate().iconP2.x = playstate().healthBar.x
					  + (playstate().healthBar.width * (FlxMath.remapToRange(2 - playstate().healthBar.value, 0, 2, 100, 0) * 0.01))
					  - (playstate().iconP2.width - HealthIcon.POSITION_OFFSET);
					playstate().iconP2.y = playstate().healthBar.y - (playstate().iconP2.height / 2);
			}
		}
	}

	public function onUpdate(event)
	{
		if (isDefault()) return;

		playstate().vocals.playerVolume = 1;
		
		if (playstate()?.iconP1 != null) updateIconPosition(0);
		if (playstate()?.iconP2 != null) updateIconPosition(1);

		if ((!isMobile()) && (pause() != null) && (!playstate().isSubState) && hideChangeDifficulty) // To prevent changing difficulty, since its buggy (for now).
		{
			if (pause().currentMenuEntries != null)
			{
				var index:Int = 0;
				for (entry in pause().currentMenuEntries)
				{
					if (entry.text == 'Change Difficulty')
					{
						// PURGE the button :3
						pause().currentMenuEntries.remove(entry);
						pause().menuEntryText.members[index].destroy();
						pause().changeSelection();
					}
					index += 1;
				}
			}
		}
	}

	public function opposeNote(note)
	{
		note.data = giveOppositeData(note.data);
	}

	/*
	 * Enemy notes for the player, player notes for the enemy
	 */
	public function opposeChart(chart:SongDifficulty)
	{
		for (note in chart.notes)
		{
			opposeNote(note);
		}
	}

	public function findOpposedParam(note):Null<NoteParamData>
	{
		for (param in note.params)
		{
			if (param.name == 'opposed')
			{
				return param;
			}
		}
		return null;
	}

	public function opposeStrumlines()
	{		
		if (Gammod.mobile())
		{
			// Plan here is to just put the mini-strumline at the opposite side.
			return;
		}

		var playerStrumlinePos:FlxPoint = FlxPoint.get(playstate().playerStrumline.x, playstate().playerStrumline.y);
		var playerStrumlineSpd:Float = playstate().playerStrumline.scrollSpeed;

		final cutoutSize = FullScreenScaleMode.gameCutoutSize.x / 2.5;

		//playstate().playerStrumline.x = playstate().opponentStrumline.x;
		playstate().playerStrumline.x = (((FlxG.width / 2) - playstate().playerStrumline.width) - Constants.STRUMLINE_X_OFFSET) - (cutoutSize / 2.0);
		playstate().playerStrumline.y = playstate().opponentStrumline.y;

		playstate().opponentStrumline.x = (FlxG.width - playstate().opponentStrumline.width) - Constants.STRUMLINE_X_OFFSET - cutoutSize;
		playstate().opponentStrumline.y = playerStrumlinePos.y;

		playstate().playerStrumline.scrollSpeed = playstate().opponentStrumline.scrollSpeed;
		playstate().opponentStrumline.scrollSpeed = playerStrumlineSpd;

		playstate().comboPopUps.offsets = [200, 0];
	}

	function onSongEvent(event)
	{
		if (isDefault()) return;
		switch (event.eventData.eventKind)
		{
			case 'ScrollSpeed':
				switch (event.eventData.value.strumline)
				{
					case 'player':
						event.eventData.value.strumline = 'opponent';
					case 'opponent':
						event.eventData.value.strumline = 'player';
				}
		}
	}

	public function giveOppositeData(inputData:Int) //Yandere simulator ahh code
	{
		switch (inputData)
		{
			// OPPONENT NOTES
			case 4:
				return 0;
			case 5:
				return 1;
			case 6:
				return 2;
			case 7:
				return 3;

			// PLAYER NOTES
			case 0:
				return 4;
			case 1:
				return 5;
			case 2:
				return 6;
			case 3:
				return 7;
		}
	}
}