import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.math.FlxMath;
import funkin.Conductor;
import funkin.util.Constants;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import gammod.modifiers.GammodModType;
import gammod.modifiers.GammodPlatform;
import gammod.util.GammodTweenManager as Tweens;
import gammod.modifiers.GammodModifier;
import Math;

class GammodHealthLoss extends GammodModifier
{
	public function new()
	{
		super('GammodHealthLoss', GammodModType.FLOATRANGE(0.0, 15.0, 0.1), {default_value: 1.0});

		display_name = 'Health Loss';
		//prefix = {value='x'; at_default=true; at_pre_default=false;};
		colors = [0xFF7600d6,0xff7303fc];
		multiplier = {addition: null};
		description = "MULTIPLIES HEALTH LOST PER MISS";
		prefix = {shape:'x', at_default:true};
	}

	public function onNoteMiss(event:NoteScriptEvent):Void
	{
		if (value != 1.0) event.healthChange *= value;
	}

	public function onNoteGhostMiss(event:GhostMissNoteScriptEvent):Void
	{
		if (value != 1.0) event.healthChange *= value;
	}
}